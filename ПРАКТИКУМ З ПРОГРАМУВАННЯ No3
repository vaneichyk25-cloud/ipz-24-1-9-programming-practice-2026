#include <iostream>
#include <cmath>
#include <iomanip>
#include <windows.h>

using namespace std;

// Функція для обчислення факторіалу
double factorial(int n) {
    double result = 1.0;
    for (int i = 2; i <= n; i++) {
        result *= i;
    }
    return result;
}

// Функція для обчислення косинуса через ряд Тейлора
double cosTaylor(double x, double epsilon) {
    double sum = 0.0;
    int n = 0;
    double term;

    do {
        term = pow(-1, n) * pow(x, 2 * n) / factorial(2 * n);
        sum += term;
        n++;
    } while (fabs(term) >= epsilon);

    return sum;
}

int main() {
    SetConsoleCP(65001);
    SetConsoleOutputCP(65001);
    double x1, x2, dx, epsilon;

    // Введення даних згідно з прикладом
    cout << "x1=";
    cin >> x1;
    cout << "x2=";
    cin >> x2;
    cout << "dx=";
    cin >> dx;
    cout << "Epsilon=";
    cin >> epsilon;

    cout << endl;

    // Виведення заголовка як у прикладі
    cout << "--x--    --cos_x--    --cos_t--    --cos_x-cos_t--" << endl;

    // Переводимо границі в радіани для порівняння
    double x_rad_end = x2 * acos(-1.0) / 180.0;

    for (double x_deg = x1; x_deg <= x2 + 1e-9; x_deg += dx) {
        // Переводимо в радіани
        double x_rad = x_deg * acos(-1.0) / 180.0;

        // Обчислюємо косинус через ряд Тейлора
        double cos_taylor = cosTaylor(x_rad, epsilon);

        // Обчислюємо косинус через стандартну функцію (табличне значення)
        double cos_std = cos(x_rad);

        // Обчислюємо різницю
        double difference = cos_taylor - cos_std;

        // Виводимо результат з форматуванням як у прикладі
        cout << fixed << setprecision(3) << x_deg << "    "
            << setprecision(6) << cos_taylor << "    "
            << setprecision(6) << cos_std << "    "
            << setprecision(6) << difference << endl;
    }

    return 0;
}

