#include <iostream>
#include <string>
#include <windows.h>

using namespace std;

// Функція для перевірки, чи є рік високосним
bool isLeapYear(int year) {
    // Високосний рік: ділиться на 4, але не ділиться на 100,
    // або ділиться на 400
    return (year % 4 == 0 && year % 100 != 0) || (year % 400 == 0);
}

// Функція для перевірки коректності дати
bool isValidDate(int day, int month, int year) {
    if (year < 1 || month < 1 || month > 12 || day < 1) {
        return false;
    }

    // Кількість днів у місяцях
    int daysInMonth[] = { 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31 };

    // Корекція для лютого у високосний рік
    if (isLeapYear(year)) {
        daysInMonth[1] = 29;
    }

    return day <= daysInMonth[month - 1];
}

// Функція для обчислення номера дня тижня за формулою Зеллера
int getDayOfWeekNumber(int day, int month, int year) {
    // Якщо місяць січень або лютий, вважаємо їх як 13 та 14 місяці попереднього року
    if (month == 1 || month == 2) {
        month += 12;
        year--;
    }

    // Формула Зеллера для Григоріанського календаря
    int K = year % 100;          // Рік у столітті
    int J = year / 100;          // Століття
    int h = (day + (13 * (month + 1)) / 5 + K + K / 4 + J / 4 + 5 * J) % 7;

    // Повертає: 0 = субота, 1 = неділя, 2 = понеділок, ..., 6 = п'ятниця
    return h;
}

// Функція для отримання назви дня тижня за номером
string getDayName(int dayNumber) {
    switch (dayNumber) {
    case 0: return "Субота";
    case 1: return "Неділя";
    case 2: return "Понеділок";
    case 3: return "Вівторок";
    case 4: return "Середа";
    case 5: return "Четвер";
    case 6: return "П'ятниця";
    default: return "Невідомий день";
    }
}

int main() {
    SetConsoleCP(65001);
    SetConsoleOutputCP(65001);
    int day, month, year;

    // Введення дати
    cout << "Введіть день: ";
    cin >> day;

    cout << "Введіть місяць: ";
    cin >> month;

    cout << "Введіть рік: ";
    cin >> year;

    // Перевірка коректності дати
    if (!isValidDate(day, month, year)) {
        cout << "Помилка: Введено некоректну дату!" << endl;
        return 1;
    }

    // Обчислення дня тижня
    int dayNumber = getDayOfWeekNumber(day, month, year);
    string dayName = getDayName(dayNumber);

    // Виведення результату (як у прикладі)
    cout << "\nДень тижня: " << dayName << endl;

    return 0;
}

