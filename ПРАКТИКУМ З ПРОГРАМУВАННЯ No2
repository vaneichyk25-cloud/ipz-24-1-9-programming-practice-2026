    cout << "k=";
    cin >> k;

    cout << "e=";
    cin >> eps_input;

    // Обробка різних форматів введення
    stringstream ss(eps_input);
    if (eps_input.find('e') != string::npos || eps_input.find('E') != string::npos) {
        ss >> epsilon;
    }
    else if (eps_input.find('.') != string::npos) {
        ss >> epsilon;
    }
    else {
        int signs;
        ss >> signs;
        epsilon = 1.0;
        for (int i = 0; i < signs; i++) {
            epsilon /= 10.0;
        }
    }

    double y = 1.0;
    double delta = 1.0;
    int iteration = 1;

    

    while (fabs(delta) >= epsilon) {
        delta = (1.0 / k) * (x / pow(y, k - 1) - y);
        y = y + delta;

        cout << "iteration:" << iteration
            << ", delta=" << fixed << setprecision(6) << delta
            << ", y=" << fixed << setprecision(6) << y << "\n";

        iteration++;
    }

    return 0;
}

