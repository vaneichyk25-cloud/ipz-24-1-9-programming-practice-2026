#include <iostream>
#include <cmath>
#include <complex>
#include <windows.h>

using namespace std;

// Визначаємо PI вручну, якщо вона не визначена
#ifndef M_PI
#define M_PI 3.14159265358979323846
#endif

int main() {
    SetConsoleCP(65001);
    SetConsoleOutputCP(65001);
    double a, b, c;

    cout << "Введення коефіцієнтів кубічного рівняння" << endl;
    cout << "Введіть коефіцієнт a: ";
    cin >> a;
    cout << "Введіть коефіцієнт b: ";
    cin >> b;
    cout << "Введіть коефіцієнт c: ";
    cin >> c;
    cout << endl;

    // Зведене кубічне рівняння: t^3 + pt + q = 0
    // Заміна: x = t - a/3
    double p = b - a * a / 3.0;
    double q = (2.0 * a * a * a) / 27.0 - (a * b) / 3.0 + c;

    // Дискримінант
    double D = (q * q) / 4.0 + (p * p * p) / 27.0;

    complex<double> x1, x2, x3;

    if (fabs(D) < 1e-10) {  // D ≈ 0 - кратні корені
        double u = cbrt(-q / 2.0);
        double t1 = 2.0 * u;
        double t2 = -u;

        x1 = t1 - a / 3.0;
        x2 = t2 - a / 3.0;
        x3 = t2 - a / 3.0;
    }
    else if (D > 0) {  // Один дійсний і два комплексних корені
        double sqrtD = sqrt(D);
        double u = cbrt(-q / 2.0 + sqrtD);
        double v = cbrt(-q / 2.0 - sqrtD);

        double t1 = u + v;

        x1 = t1 - a / 3.0;
        x2 = complex<double>(-(u + v) / 2.0 - a / 3.0, (u - v) * sqrt(3.0) / 2.0);
        x3 = complex<double>(-(u + v) / 2.0 - a / 3.0, -(u - v) * sqrt(3.0) / 2.0);
    }
    else {  // D < 0 - три дійсних корені (формула Вієта)
        double phi = acos(-q / (2.0 * sqrt(-p * p * p / 27.0)));
        double r = 2.0 * sqrt(-p / 3.0);

        double t1 = r * cos(phi / 3.0);
        double t2 = r * cos((phi + 2.0 * M_PI) / 3.0);
        double t3 = r * cos((phi + 4.0 * M_PI) / 3.0);

        x1 = t1 - a / 3.0;
        x2 = t2 - a / 3.0;
        x3 = t3 - a / 3.0;
    }

    // Виведення результатів
    cout << "Результаты:" << endl;

    if (abs(x1.imag()) < 1e-10) {
        cout << "x1 = " << x1.real() << endl;
    }
    else {
        cout << "x1 = " << x1.real() << " + " << x1.imag() << "*i" << endl;
    }

    if (abs(x2.imag()) < 1e-10) {
        cout << "x2 = " << x2.real() << endl;
    }
    else {
        cout << "x2 = " << x2.real() << " + " << x2.imag() << "*i" << endl;
    }

    if (abs(x3.imag()) < 1e-10) {
        cout << "x3 = " << x3.real() << endl;
    }
    else {
        cout << "x3 = " << x3.real() << " + " << x3.imag() << "*i" << endl;
    }

    return 0;
}

